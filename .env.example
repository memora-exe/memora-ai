# ─── Google AI ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─── Server ────────────────────────────────────────────────
PORT=3100

# ─── NestJS Backend (caller) ───────────────────────────────
NESTJS_API_URL=http://localhost:3000

# ─── PostgreSQL / pgvector ─────────────────────────────────
DB_REPO_HOST=localhost
DB_REPO_PORT=5433
DB_REPO_USERNAME=postgres
DB_REPO_PASSWORD=postgres
DB_REPO_NAME=repo

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ─── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

# ─── Phase 2 Hybrid Search ─────────────────────────────────
GEMINI_MODEL=gemini-3.1
HYBRID_TOP_K=5
HYBRID_TRAVERSE_DEPTH=2
HYBRID_MAX_NODES=20

# ─── Phase 3 — AI Search / Node Summary / Document Reader ──
SUMMARY_MODEL=gemini-3.1
NODE_SUMMARY_MAX_TOKENS=1024
DOC_SUMMARY_MAX_TOKENS=2048
SEARCH_TOP_K=10
FOCAL_PADDING=1.4
DOC_SUMMARY_INPUT_CAP=80000

# ─── Internal (used by rabbitmq_consumer) ──────────────────
SYSTEM_JWT_TOKEN=