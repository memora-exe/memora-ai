GRPC_MAX_WORKERS=10

# ─── Port Allocation (CLAUDE.md: FE=3000, BE=3010, AI=3020) ──────
PORT=3020

# ─── AI Model Providers (OpenAI Spec Only) ──────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=memora
