# ─── Google AI (legacy — only needed if hitting Google directly) ──
# Only kept for any external caller still reading GOOGLE_API_KEY. The internal
# dispatcher no longer imports langchain-google-genai — see OPENAI_BASE_URL
# below for the OpenAI-API-spec way to reach Gemini.
GOOGLE_API_KEY=your_google_api_key_here

# ─── Server ────────────────────────────────────────────────
PORT=3100

# ─── NestJS Backend (caller) ───────────────────────────────
NESTJS_API_URL=http://localhost:3000

# ─── PostgreSQL (graph/application metadata) ─────────────────
DB_REPO_HOST=localhost
DB_REPO_PORT=5433
DB_REPO_USERNAME=postgres
DB_REPO_PASSWORD=postgres
DB_REPO_NAME=repo

# ─── Parsed document storage ────────────────────────────────
STORAGE_BASE_DIR=./storage

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ─── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

# ─── LLM Provider (OpenAI API Specification) ───────────────
# One transport for everything: Authorization: Bearer <OPENAI_API_KEY>
# POST <OPENAI_BASE_URL>/chat/completions. Point at any OpenAI-compatible
# endpoint to switch providers — NO code change required.
#
# Common endpoints:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Azure:        https://<resource>.openai.azure.com/openai/deployments/<dep>
#   Gemini*:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:       http://localhost:11434/v1
#   vLLM/TGI:     http://localhost:8000/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Default chat model. Change this one var to swap across the entire stack.
OPENAI_MODEL=gpt-4o-mini

# ─── Phase 4 — Numeric knobs ───────────────────────────────
ROADMAP_TOP_K_SEEDS=10
ROADMAP_MAX_STAGES=4
ROADMAP_DOC_TEXT_CHAR_BUDGET=80000
ROADMAP_MAX_FILE_IDS=5
INSIGHTS_DEGREE_GAP_THRESHOLD=2


# ─── Phase 3 — AI Search / Node Summary / Document Reader ──
NODE_SUMMARY_MAX_TOKENS=1024
DOC_SUMMARY_MAX_TOKENS=2048
SEARCH_TOP_K=10
FOCAL_PADDING=1.4
DOC_SUMMARY_INPUT_CAP=80000

# ─── Internal (used by rabbitmq_consumer) ──────────────────
SYSTEM_JWT_TOKEN=
# Shared secret for the BE's /internal/files/:id/status endpoints.
# MUST match MEMORA_INTERNAL_TOKEN set on the NestJS side (InternalTokenGuard).
# Leave blank if the BE never exposes internal endpoints (will skip the
# cooperative cancel + sync-status fallback paths).
MEMORA_INTERNAL_TOKEN=
