# ─── Stateless gRPC Technical Proxy Configuration ───────────
# GRPC_PORT defaults to 50051 for internal microservice communication
GRPC_PORT=50051
GRPC_MAX_WORKERS=10

# ─── Port Allocation (CLAUDE.md: FE=3000, BE=3010, AI=3020) ──────
PORT=3020

# ─── AI Model Providers (OpenAI Spec Only) ──────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
